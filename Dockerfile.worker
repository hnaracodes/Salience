FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir sqlalchemy asyncpg psycopg2-binary arq boto3 modal tldextract sqlalchemy psycopg2-binary

# Base image ships Chromium; this ensures it's present with all deps.
RUN playwright install chromium --with-deps

COPY . .

CMD ["python", "-m", "arq", "services.api.jobs.WorkerSettings"]
