*.py[cod]
.venv/
.venv311
.venv-deepgaze-msdb/
node_modules

.env
.env.*
!.env.example

# Local demo / stimulus videos (regenerate or place locally; never commit)
*.mp4
*.webm
*.mkv
*.m4a

# Local runtime / DB (regenerate from Modal + analyze_session)
*.sqlite

# Large neuroimaging / ML artifacts (download or generate locally)
*.nii.gz
*.joblib
