# Copy to .env and fill in locally. Never commit .env.
HUGGING_FACE_API_KEY=hf_your_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Railway / Vercel deployment secrets
DATABASE_URL=postgresql+asyncpg://scout:scout@localhost:5432/scout
REDIS_URL=redis://localhost:6379
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scout-artifacts
R2_PUBLIC_URL=https://pub.<accountid>.r2.dev
CLERK_JWKS_URL=https://<clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<clerk-domain>
CORS_ORIGINS=["https://your-vercel-domain.vercel.app"]
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
FAKE_TRIBE=0
