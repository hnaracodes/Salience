# Copy to .env and fill in locally. Never commit .env.
HUGGING_FACE_API_KEY=hf_your_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Session pooler recommended on Windows — direct db.* is IPv6-only)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Upstash Redis (Arq queue) — use the TCP URL from Upstash dashboard
REDIS_URL=rediss://default:[password]@[name].upstash.io:6379
# Optional: REST token for Upstash HTTP API (not used by Arq)
# UPSTASH_REDIS_REST_TOKEN=

# Backblaze B2 (S3-compatible object storage for scan viewer bundles)
S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=salience-prod
# Omit S3_PUBLIC_URL to use 7-day presigned viewer URLs (recommended for MVP)

# Legacy R2_* names still work for local docker-compose MinIO (see docker-compose.yml)

CLERK_JWKS_URL=https://<clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<clerk-domain>
CORS_ORIGINS=["https://your-vercel-domain.vercel.app"]
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
FAKE_TRIBE=0
